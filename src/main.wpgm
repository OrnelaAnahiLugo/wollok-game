import wollok.game.*

import src.vicky.*

import config.paredesHandler.*

import config.colisiones.*
import src.controladorEnemigo.*
import src.controladorPellets.*

program PacvickyGame {
	game.title("Escapando de scream")

	game.cellSize(32)

	game.height(25)
	game.width(25)

	game.boardGround("mapa_1.png")

	paredesHandler.generarParedes()
	controladorPellets.generarPellets()

	game.addVisual(vicky)
	colisiones.configurarColision(vicky)

	keyboard.up().whilePressedDo({ vicky.moverseArriba() }, 200)
	keyboard.down().whilePressedDo({ vicky.moverseAbajo() }, 200)
	keyboard.right().whilePressedDo({ vicky.moverseDerecha() }, 200)
	keyboard.left().whilePressedDo({ vicky.moverseIzquierda() }, 200)
	

	const tick = game.tick(100, { controladorEnemigo.crearEnemigo() }, false)
	tick.start()

	controladorEnemigo.manejarEnemigos()

	game.start()

}
