import wollok.game.*

import src.vicky.*

import config.paredesHandler.*

import config.colisiones.*
import config.direccion.*
import src.controladorEnemigo.*
import src.controladorPellets.*
import src.controladorObjetos.*

program PacvickyGame {
	game.title("Escapando de scream")

	game.cellSize(32)

	game.height(25)
	game.width(25)

	game.boardGround("mapa_1.png")

	paredesHandler.generarParedes()
	controladorPellets.generarPellets()

	game.addVisual(vicky)
	colisiones.revisarColisiones(vicky)

	// TODO: Mover a un controlador de movimiento
	keyboard.up().onPressDo({ vicky.quererMoverseHacia(arriba) })
	keyboard.down().onPressDo({ vicky.quererMoverseHacia(abajo) })
	keyboard.right().onPressDo({ vicky.quererMoverseHacia(derecha) })
	keyboard.left().onPressDo({ vicky.quererMoverseHacia(izquierda) })

	const tickVicky = game.tick(150, { vicky.avanzar() }, false)
	tickVicky.start()

	const tick = game.tick(100, { controladorEnemigo.crearEnemigo() }, false)
	tick.start()

	controladorObjetos.iniciar()

	controladorEnemigo.manejarEnemigos()

	game.start()

}
